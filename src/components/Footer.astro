---
const today = new Date();
---

<footer>
	<div class="inner">
		<span class="copy"># © {today.getFullYear()} 박성진</span>
		<span class="links">
			<a href="https://github.com/Kouen-Park" target="_blank" rel="noopener noreferrer">github</a>
			<a href="/rss.xml">rss</a>
		</span>
	</div>
</footer>

<style>
	footer {
		background: var(--panel);
		border-top: 1px dashed var(--border);
	}
	.inner {
		width: 100%;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 1.25rem 1.5rem 2.25rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--fg-faint);
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	.links a {
		color: var(--fg-muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
</style>
