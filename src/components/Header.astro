---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a class="prompt" href="/">
			<span class="host">parkseongjin.me</span><span class="sep">:~$</span>
		</a>
		<div class="nav-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/blog">posts</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		background: var(--panel);
		border-bottom: 1px dashed var(--border);
	}
	nav {
		width: 100%;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0.8rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}

	.prompt {
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	.prompt .host {
		color: var(--accent);
		font-weight: 700;
	}
	.prompt .sep {
		color: var(--fg-faint);
	}
	.prompt:hover .host {
		text-decoration: underline;
	}

	.nav-links {
		display: flex;
		gap: 0.85rem;
		margin-left: auto;
	}

	@media (max-width: 460px) {
		nav {
			gap: 0.6rem;
		}
		.nav-links {
			gap: 0.6rem;
		}
	}
</style>
