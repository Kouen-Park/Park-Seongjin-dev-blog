---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;

// heroImage는 선택 항목입니다. 없으면 썸네일 칸 없이 1단으로 흐르게 해서
// 레이아웃이 무너지지 않도록 합니다.
const hasThumb = Boolean(heroImage);
---

<li>
	<a href={`/blog/${post.id}/`} class:list={[{ 'no-thumb': !hasThumb }]}>
		{
			heroImage && (
				<Image class="thumb" src={heroImage} alt="" width={208} height={140} loading="lazy" />
			)
		}
		<div class="body">
			<div class="meta">
				<FormattedDate date={pubDate} />
				<span class="file">{post.id}.md</span>
			</div>
			<h3 class="title">{title}</h3>
			<p class="desc">{description}</p>
		</div>
	</a>
</li>

<style>
	li {
		border-bottom: 1px dashed var(--border);
	}
	li:first-child {
		border-top: 1px dashed var(--border);
	}

	a {
		display: grid;
		grid-template-columns: 104px 1fr;
		gap: 1rem;
		align-items: start;
		padding: 0.9rem 0.5rem;
		text-decoration: none;
		color: inherit;
		transition: background 0.12s ease;
	}
	a.no-thumb {
		grid-template-columns: 1fr;
	}
	a:hover {
		background: var(--panel);
	}
	a:hover .title {
		color: var(--accent);
	}
	a:hover .thumb {
		border-color: var(--accent);
		border-style: solid;
	}

	.thumb {
		width: 104px;
		height: 70px;
		object-fit: cover;
		border: 1px dashed var(--border);
		border-radius: 4px;
		transition: border-color 0.12s ease;
	}

	.body {
		min-width: 0;
	}

	.meta {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--fg-faint);
	}
	.file {
		opacity: 0.75;
	}

	.title {
		margin: 0.15rem 0 0.25rem;
		font-size: 1rem;
		line-height: 1.45;
		transition: color 0.12s ease;
	}

	.desc {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--fg-muted);
		/* 목록에서는 2줄까지만 — 글마다 높이가 들쭉날쭉해지지 않도록 */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 520px) {
		a {
			grid-template-columns: 76px 1fr;
			gap: 0.75rem;
		}
		.thumb {
			width: 76px;
			height: 52px;
		}
	}
</style>
