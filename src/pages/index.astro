---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostRow from '../components/PostRow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts } from '../utils/posts';

// 홈에는 최신 5개만. 전체는 /blog 에서 봅니다.
const RECENT_COUNT = 5;

const allPosts = await getSortedPosts();
const posts = allPosts.slice(0, RECENT_COUNT);
const hasMore = allPosts.length > RECENT_COUNT;

// 소개할 프로젝트. 늘어나면 별도 컬렉션으로 옮기는 편이 낫습니다.
const projects = [
	{
		name: 'Noye',
		stack: 'FastAPI · Qdrant · Ollama',
		desc: '내 컴퓨터 안에서만 돌아가는 문서 검색 도구. 키워드가 아니라 뜻으로 찾아주고, 답을 줄 때 어느 문서 몇 페이지에서 나왔는지까지 같이 보여줍니다.',
		href: 'https://github.com/Kouen-Park/Noye',
	},
	{
		name: 'BirdieBuddy',
		stack: 'ASP.NET Core · SwiftUI',
		desc: '골프 라운드 기록 앱. 필드에서 인터넷이 끊겨도 점수는 일단 폰에 저장되고, 신호가 돌아오면 알아서 서버로 올라갑니다.',
		href: 'https://github.com/Kouen-Park/BirdieBuddy',
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>만들면서 배우는 기록<span class="cursor" aria-hidden="true"></span></h1>
				<p class="hero-note"># 배운 것, 삽질한 것, 만든 것을 하나씩 적어둡니다.</p>
			</div>

			<p class="section-label">
				<span>ls -t posts/</span>
				{hasMore && <a href="/blog/">전체 보기 →</a>}
			</p>
			{
				posts.length > 0 ? (
					<ul class="posts">
						{posts.map((post) => (
							<PostRow post={post} />
						))}
					</ul>
				) : (
					<p class="empty"># 아직 글이 없습니다.</p>
				)
			}

			<p class="section-label"><span>ls projects/</span></p>
			<div class="projects">
				{
					projects.map((p) => (
						<a class="proj" href={p.href} target="_blank" rel="noopener noreferrer">
							<span class="proj-name">{p.name}</span>
							<span class="proj-stack">{p.stack}</span>
							<p class="proj-desc">{p.desc}</p>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		margin-bottom: 0.3rem;
	}
	.cursor {
		display: inline-block;
		width: 0.45em;
		height: 0.95em;
		margin-left: 0.1em;
		background: var(--accent);
		vertical-align: baseline;
		animation: blink 1.1s step-end infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	/* 깜빡임을 원치 않는 사용자에게는 정적 블록으로 */
	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}

	.hero-note {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--fg-muted);
		margin: 0;
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.empty {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--fg-faint);
	}

	.projects {
		display: grid;
		gap: 0.5rem;
	}
	.proj {
		display: block;
		padding: 0.75rem 0.9rem;
		border: 1px dashed var(--border);
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		transition: border-color 0.15s ease;
	}
	.proj:hover {
		border-color: var(--accent);
		border-style: solid;
	}
	.proj-name {
		color: var(--accent);
		font-weight: 700;
	}
	.proj-name::before {
		content: '~/';
		color: var(--fg-faint);
		font-weight: 400;
	}
	.proj-stack {
		margin-left: 0.5rem;
		font-size: 0.7rem;
		color: var(--fg-faint);
	}
	.proj-desc {
		margin: 0.3rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.85rem;
		line-height: 1.65;
		color: var(--fg-muted);
	}
</style>
