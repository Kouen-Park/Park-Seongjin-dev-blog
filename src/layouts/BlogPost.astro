---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { fileName?: string };

const { title, description, pubDate, updatedDate, heroImage, fileName } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="head">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{fileName && <span class="file">{fileName}</span>}
					</div>
					<h1>{title}</h1>
					{
						updatedDate && (
							<p class="updated">
								# 마지막 수정 <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</div>

				{
					heroImage && (
						<figure class="hero-image">
							<Image src={heroImage} alt="" loading="eager" />
						</figure>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>

			<p class="back"><a href="/blog/">&larr; cd ../posts</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.head {
		padding-bottom: 1.25rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px dashed var(--border);
	}
	.meta {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--fg-faint);
		margin-bottom: 0.35rem;
	}
	.file {
		opacity: 0.75;
	}
	.head h1 {
		margin: 0;
	}
	.updated {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--fg-faint);
		margin: 0.5rem 0 0;
	}

	/* 히어로 이미지도 목록 썸네일과 같은 '파일 프리뷰' 처리.
	   세로형 이미지도 찌그러지지 않도록 원본 비율을 지키고,
	   너무 길어지지 않게 높이만 제한합니다. */
	.hero-image {
		margin: 0 0 2rem;
		text-align: center;
	}
	.hero-image :global(img) {
		display: block;
		max-width: 100%;
		max-height: 460px;
		width: auto;
		height: auto;
		margin: 0 auto;
		border: 1px dashed var(--border);
		border-radius: var(--radius);
	}

	.back {
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px dashed var(--border);
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}
	.back a {
		text-decoration: none;
	}
	.back a:hover {
		text-decoration: underline;
	}
</style>
